# Copy this file to .env and fill in real values. NEVER commit the real .env
# file to source control (see .gitignore) — this is the secure-coding
# requirement from Proposal Section 10 re: secrets management.

NODE_ENV=development
PORT=4000

# Postgres connection string. When using docker-compose, host = 'db'.
DATABASE_URL=postgresql://weblook:weblook_dev_password@localhost:5432/weblook_shield

# Generate strong random secrets, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-long-random-string
JWT_REFRESH_SECRET=replace-with-a-different-long-random-string
CSRF_SECRET=replace-with-another-long-random-string

JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CORS_ORIGIN=http://localhost:5173

MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
BCRYPT_ROUNDS=12
