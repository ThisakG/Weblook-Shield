{
  "name": "weblook-shield-backend",
  "version": "1.0.0",
  "description": "Weblook Shield API — Information Security Policy Awareness & Management Platform (IE3072 Group 01)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "migrate": "node -e \"require('./src/config/db').pool.query(require('fs').readFileSync('./src/db/schema.sql','utf8')).then(()=>{console.log('Schema applied.');process.exit(0)}).catch(e=>{console.error(e);process.exit(1)})\"",
    "seed": "node src/db/seed.js",
    "test": "jest --runInBand",
    "lint": "eslint src"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.2.0",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0",
    "qrcode": "^1.5.4",
    "speakeasy": "^2.0.0"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.4",
    "supertest": "^7.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ]
  }
}
